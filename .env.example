MEMORY_DB_PATH=~/.memoryvault/memory.db
MEMORYVAULT_WORKER_BATCH_SIZE=100
MEMORYVAULT_WORKER_POLL_MS=1000
OLLAMA_BASE_URL=http://localhost:11434

# E2EE encryption (optional — set after running: memory-vault-cli init-encryption)
# MEMORYVAULT_PASSPHRASE=your-secret-passphrase

# Supabase cloud sync (optional — set via: memory-vault-cli setup)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Dashboard port
# Dashboard is loopback-only; use an authenticated reverse proxy for remote access
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=3080

# Streamable HTTP MCP (optional)
# MEMORYVAULT_HTTP_HOST=127.0.0.1
# MEMORYVAULT_HTTP_PORT=3090
# Per-Agent Principal file (recommended for shared/AgentTeams deployments)
# MEMORYVAULT_HTTP_PRINCIPALS_FILE=~/.memoryvault/http-principals.json
# Refuse unauthenticated non-loopback HTTP unless explicitly set to 1 (demo only)
# MEMORYVAULT_HTTP_ALLOW_INSECURE=0
# Legacy single-user compatibility only; do not combine with the Principal file
# MEMORYVAULT_HTTP_TOKEN=change-me
